# =============================================================================
# The Lenny Growth Assistant — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.
# =============================================================================

# --- Database ---
# Postgres connection string. The Docker Compose default connects to the
# local postgres container. Replace with a Supabase connection string if
# using a hosted DB.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/lenny_assistant

# --- Anthropic Claude via Amazon Bedrock ---
# Set to 1 to route Claude Agent SDK through Bedrock (required).
CLAUDE_CODE_USE_BEDROCK=1

# AWS credentials with bedrock:InvokeModel permission.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Bedrock model ID — must match the model you've enabled in the Bedrock console.
# Example: us.anthropic.claude-sonnet-4-20250514-v1:0
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0

# --- Groq (local-LLM slot substitute for Ollama) ---
# Free API key from https://console.groq.com
GROQ_API_KEY=

# Groq model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# --- Provider Configuration ---
# Default LLM provider: "anthropic" (via Bedrock) or "groq"
DEFAULT_PROVIDER=groq

# Bedrock call timeout in seconds (guards against known SDK hang issue)
BEDROCK_TIMEOUT_SECONDS=20

# --- Retrieval ---
# Minimum cosine similarity for a chunk to be considered relevant.
# pgvector <=> returns distance; code converts: max_distance = 1 - threshold.
SIMILARITY_THRESHOLD=0.35

# Number of top chunks to retrieve per query.
RETRIEVAL_TOP_K=5

# --- Application ---
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
